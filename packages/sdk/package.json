{
	"name": "@velix/sdk",
	"version": "0.0.1-alpha.10",
	"private": true,
	"description": "TypeScript SDK for the Velix API",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"devDependencies": {
		"@velix/typescript": "workspace:*",
		"bun-types": "1.3.11",
		"typescript": "5.9.3"
	},
	"publishConfig": {
		"access": "public",
		"name": "@velix_sh/sdk"
	}
}
