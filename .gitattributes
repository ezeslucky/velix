# Normalize line endings to LF for all text files across platforms.
# Biome (format + lint) and CI expect LF; without this, Windows checkouts
# get CRLF via core.autocrlf and Biome flags every line.
* text=auto eol=lf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.mp4 binary
*.webm binary
*.mov binary
*.node binary
*.wasm binary
*.zip binary
*.gz binary
